@page "/characters"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Player)]
@using System.Security.Claims
@using RolemasterCharacterCreation.Data
@using RolemasterCharacterCreation.Models
@using RolemasterCharacterCreation.Rules
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Characters</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="mb-0">Characters</h2>
    <button class="btn btn-success" @onclick="CreateAsync" disabled="@_creating">
        @(_creating ? "Creating…" : "+ New Character")
    </button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible">
        @_message
        <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

<table class="table table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Race</th>
            <th>Profession</th>
            <th>Level</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ch in _characters)
        {
            <tr>
                <td>@ch.Name</td>
                <td>@(ch.Race ?? "—")</td>
                <td>@(ch.Profession ?? "—")</td>
                <td>@ch.Level</td>
                <td class="text-end">
                    @if (CanAccessWizard(ch))
                    {
                        <a class="btn btn-sm btn-outline-success me-1" href="@($"/character/{ch.Id}/wizard")">Wizard</a>
                    }
                    <a class="btn btn-sm btn-outline-primary me-1" href="@($"/character/{ch.Id}/sheet")">Show</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!_characters.Any())
{
    <p class="text-muted">No characters yet. Click <strong>New Character</strong> to build one, or ask your Gamemaster.</p>
}

<RuleBookDownloads />

@code {
    private List<Character> _characters = [];
    private string? _message;
    private bool _isError;
    private bool _creating;
    private string? _userId;

    static bool CanAccessWizard(Character ch) =>
        (ch.Level == 1 && ch.WizardStep < 5) ||   // initial creation in progress
        ch.LevelUpBaselineJson != null             ||   // level-up started but not finished
        ch.CurrentXp >= 10000 * ch.Level;              // enough XP to start a new level-up

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId  = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);

        _characters = await Db.Characters
            .Where(c => c.UserId == _userId)
            .OrderBy(c => c.Name)
            .ToListAsync();
    }

    // Create a blank character owned by the player and jump straight into the wizard,
    // where they fill in name, race, culture, profession, stats and the rest.
    private async Task CreateAsync()
    {
        if (string.IsNullOrEmpty(_userId) || _creating) return;

        _creating = true;
        var character = new Character
        {
            Name = "New Character",
            UserId = _userId,
            WizardStep = 0,
            CreatedAt = DateTime.UtcNow
        };
        Db.Characters.Add(character);
        await Db.SaveChangesAsync();

        Nav.NavigateTo($"/character/{character.Id}/wizard");
    }
}
