@page "/gm/session-notes"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Gamemaster)]
@using System.Text
@using System.Text.RegularExpressions
@using RolemasterCharacterCreation.Data
@using RolemasterCharacterCreation.Identity
@using RolemasterCharacterCreation.Models
@using RolemasterCharacterCreation.Services
@implements IDisposable
@inject AppDbContext Db
@inject IJSRuntime JS

<PageTitle>Session Notes</PageTitle>

@* The upload endpoint validates this; without it a pasted picture is refused. *@
<AntiforgeryToken />

<h2 class="mb-3">Session Notes</h2>

<p class="text-muted">
    Keep a record for each game session. <strong>Public notes</strong> are visible to your players
    on their read-only Session Notes page; <strong>GM notes</strong> are only ever shown here.
    Paste or drag pictures straight into either box — a picture in the GM notes stays private.
</p>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible">
        @_message
        <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

<div class="card mb-4" style="max-width:820px">
    <div class="card-body">
        <h5 class="card-title">Add a session</h5>
        <div class="row g-2 mb-2">
            <div class="col-sm-3">
                <label class="form-label mb-1">Date</label>
                <input type="date" class="form-control form-control-sm" @bind="_newDate" />
            </div>
            <div class="col-sm-9">
                <label class="form-label mb-1">Title</label>
                <input class="form-control form-control-sm" @bind="_newTitle" placeholder="e.g. Session 12 — Into the Crypt" />
            </div>
        </div>
        <div class="mb-2">
            <label class="form-label mb-1">Public notes <span class="text-muted">(players can read these)</span></label>
            <div id="@NewPublicKey" @key="@($"{NewPublicKey}-{_composeToken}")"></div>
        </div>
        <div class="mb-3">
            <label class="form-label mb-1">GM notes <span class="text-muted">(GM only)</span></label>
            <div id="@NewGmKey" @key="@($"{NewGmKey}-{_composeToken}")"></div>
        </div>
        <button class="btn btn-primary" @onclick="AddAsync">+ Add session</button>
    </div>
</div>

@if (_notes.Count == 0)
{
    <p class="fst-italic text-muted">No sessions recorded yet. Add your first one above.</p>
}
else
{
    @foreach (var n in _notes)
    {
        <div class="card mb-3" style="max-width:820px" @key="n.Id">
            <div class="card-body">
                @if (_editId == n.Id)
                {
                    <div class="row g-2 mb-2">
                        <div class="col-sm-3">
                            <label class="form-label mb-1">Date</label>
                            <input type="date" class="form-control form-control-sm" @bind="_editDate" />
                        </div>
                        <div class="col-sm-9">
                            <label class="form-label mb-1">Title</label>
                            <input class="form-control form-control-sm" @bind="_editTitle" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-1">Public notes</label>
                        <div id="@EditPublicKey" @key="@($"{EditPublicKey}-{n.Id}")"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label mb-1">GM notes</label>
                        <div id="@EditGmKey" @key="@($"{EditGmKey}-{n.Id}")"></div>
                    </div>
                    <button class="btn btn-sm btn-primary" @onclick="SaveAsync">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title mb-0">@n.Title</h5>
                            <div class="small text-muted">@n.SessionDate.ToString("dddd, d MMMM yyyy")</div>
                        </div>
                        <div class="text-end">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => BeginEdit(n)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(n)">Delete</button>
                        </div>
                    </div>

                    <div class="mt-3">
                        <div class="fw-semibold small text-uppercase text-muted">Public notes</div>
                        @RenderNotes(n.PublicNotes, n.NotesAreHtml)
                    </div>

                    <div class="mt-3">
                        <div class="fw-semibold small text-uppercase text-muted">GM notes</div>
                        @RenderNotes(n.GmNotes, n.NotesAreHtml)
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    // Element ids double as the key the JS wrapper files each Quill instance under.
    private const string NewPublicKey  = "note-new-public";
    private const string NewGmKey      = "note-new-gm";
    private const string EditPublicKey = "note-edit-public";
    private const string EditGmKey     = "note-edit-gm";

    private List<SessionNote> _notes = [];

    private DateTime _newDate = DateTime.Today;
    private string? _newTitle;
    // Bumped after a successful add so Blazor rebuilds the compose boxes and they come back empty.
    private int _composeToken;

    private int? _editId;
    private DateTime _editDate;
    private string? _editTitle;

    private string? _message;
    private bool _isError;

    private DotNetObjectReference<SessionNotes>? _dotNetRef;
    // Which editors are already attached, so a re-render does not stack a second Quill on one div.
    private readonly HashSet<string> _attached = [];
    private readonly Dictionary<string, string> _pendingHtml = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await SweepOrphansAsync();
    }

    private async Task LoadAsync() =>
        _notes = await Db.SessionNotes
            .OrderByDescending(n => n.SessionDate)
            .ThenByDescending(n => n.Id)
            .ToListAsync();

    // A picture uploaded into a session that was then abandoned belongs to nothing. Clearing
    // yesterday's leftovers keeps that from growing without ever touching an image that a
    // compose box still has on screen.
    private async Task SweepOrphansAsync()
    {
        var cutoff = DateTime.UtcNow.AddDays(-1);
        var stale = await Db.SessionNoteImages
            .Where(i => i.SessionNoteId == null && i.CreatedAt < cutoff)
            .ToListAsync();
        if (stale.Count == 0) return;
        Db.SessionNoteImages.RemoveRange(stale);
        await Db.SaveChangesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);

        // Attach to whichever boxes are on screen now. The compose pair is always present; the
        // edit pair only while a note is open.
        await AttachAsync(NewPublicKey, _pendingHtml.GetValueOrDefault(NewPublicKey), gmOnly: false);
        await AttachAsync(NewGmKey, _pendingHtml.GetValueOrDefault(NewGmKey), gmOnly: true);

        if (_editId is not null)
        {
            await AttachAsync(EditPublicKey, _pendingHtml.GetValueOrDefault(EditPublicKey), gmOnly: false);
            await AttachAsync(EditGmKey, _pendingHtml.GetValueOrDefault(EditGmKey), gmOnly: true);
        }
    }

    private async Task AttachAsync(string key, string? initialHtml, bool gmOnly)
    {
        if (!_attached.Add(key)) return;
        await JS.InvokeVoidAsync("noteEditor.init", key, key, initialHtml ?? "", gmOnly, _dotNetRef);
    }

    private async Task DetachAsync(params string[] keys)
    {
        foreach (var key in keys)
            if (_attached.Remove(key))
                await JS.InvokeVoidAsync("noteEditor.destroy", key);
    }

    private async Task<string?> PullAsync(string key)
    {
        var html = await JS.InvokeAsync<string>("noteEditor.getHtml", key);
        return string.IsNullOrWhiteSpace(html) ? null : HtmlSanitizing.Notes(html);
    }

    /// <summary>An upload the editor could not complete — a file too large, or the wrong type.</summary>
    [JSInvokable]
    public void OnEditorError(string message)
    {
        SetMessage(message, error: true);
        StateHasChanged();
    }

    private async Task AddAsync()
    {
        var title = _newTitle?.Trim();
        if (string.IsNullOrWhiteSpace(title))
        {
            SetMessage("A title is required.", error: true);
            return;
        }

        var note = new SessionNote
        {
            SessionDate = _newDate,
            Title = title,
            PublicNotes = await PullAsync(NewPublicKey),
            GmNotes = await PullAsync(NewGmKey),
            NotesAreHtml = true,
        };
        Db.SessionNotes.Add(note);
        await Db.SaveChangesAsync();
        await AdoptImagesAsync(note);

        // Tear the compose boxes down and bump the key so they are rebuilt empty.
        await DetachAsync(NewPublicKey, NewGmKey);
        _newDate = DateTime.Today;
        _newTitle = null;
        _pendingHtml.Remove(NewPublicKey);
        _pendingHtml.Remove(NewGmKey);
        _composeToken++;

        await LoadAsync();
        SetMessage($"Added \"{title}\".");
    }

    private async Task BeginEdit(SessionNote n)
    {
        await DetachAsync(EditPublicKey, EditGmKey);
        _editId = n.Id;
        _editDate = n.SessionDate;
        _editTitle = n.Title;
        // A note written before the editor existed is plain text; it becomes paragraphs here
        // rather than arriving in the editor as one run-on line.
        _pendingHtml[EditPublicKey] = AsEditorHtml(n.PublicNotes, n.NotesAreHtml);
        _pendingHtml[EditGmKey] = AsEditorHtml(n.GmNotes, n.NotesAreHtml);
        _message = null;
    }

    private async Task CancelEdit()
    {
        await DetachAsync(EditPublicKey, EditGmKey);
        _editId = null;
    }

    private async Task SaveAsync()
    {
        var note = _notes.FirstOrDefault(n => n.Id == _editId);
        if (note is null) { _editId = null; return; }

        var title = _editTitle?.Trim();
        if (string.IsNullOrWhiteSpace(title))
        {
            SetMessage("A title is required.", error: true);
            return;
        }

        note.SessionDate = _editDate;
        note.Title = title;
        note.PublicNotes = await PullAsync(EditPublicKey);
        note.GmNotes = await PullAsync(EditGmKey);
        note.NotesAreHtml = true;
        note.UpdatedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await AdoptImagesAsync(note);

        await DetachAsync(EditPublicKey, EditGmKey);
        _editId = null;
        await LoadAsync();
        SetMessage($"Saved \"{title}\".");
    }

    private async Task DeleteAsync(SessionNote n)
    {
        Db.SessionNotes.Remove(n);      // its images cascade with it
        await Db.SaveChangesAsync();
        if (_editId == n.Id) { await DetachAsync(EditPublicKey, EditGmKey); _editId = null; }
        await LoadAsync();
        SetMessage($"Deleted \"{n.Title}\".");
    }

    // Pictures upload before the note they belong to necessarily exists, so the link is made
    // here from whichever image URLs actually survived into the saved text. Reading the field
    // they ended up in — rather than the field they were pasted into — is what keeps GmOnly
    // right for a picture the GM moved from the private notes to the public ones.
    private static readonly Regex ImageRef =
        new(@"/session-notes/image/(\d+)", RegexOptions.Compiled);

    private async Task AdoptImagesAsync(SessionNote note)
    {
        var inPublic = Ids(note.PublicNotes);
        var inGm = Ids(note.GmNotes);
        var all = inPublic.Union(inGm).ToList();
        if (all.Count == 0) return;

        var rows = await Db.SessionNoteImages.Where(i => all.Contains(i.Id)).ToListAsync();
        foreach (var row in rows)
        {
            row.SessionNoteId = note.Id;
            row.GmOnly = inGm.Contains(row.Id) && !inPublic.Contains(row.Id);
        }
        await Db.SaveChangesAsync();

        static HashSet<int> Ids(string? html) =>
            html is null ? []
            : ImageRef.Matches(html).Select(m => int.Parse(m.Groups[1].Value)).ToHashSet();
    }

    /// <summary>What the editor should open with: stored HTML, or plain text turned into paragraphs.</summary>
    private static string AsEditorHtml(string? stored, bool isHtml)
    {
        if (string.IsNullOrWhiteSpace(stored)) return "";
        if (isHtml) return HtmlSanitizing.Notes(stored);

        var sb = new StringBuilder();
        foreach (var line in stored.Replace("\r\n", "\n").Split('\n'))
            sb.Append("<p>").Append(System.Net.WebUtility.HtmlEncode(line)).Append("</p>");
        return sb.ToString();
    }

    /// <summary>
    /// Rich text goes out as markup, sanitised again on the way; a note from before the editor
    /// existed keeps rendering exactly as it always has, encoded with its line breaks intact.
    /// </summary>
    private RenderFragment RenderNotes(string? notes, bool isHtml) => __builder =>
    {
        if (string.IsNullOrWhiteSpace(notes))
        {
            <p class="fst-italic text-muted mb-0">None.</p>
        }
        else if (isHtml)
        {
            <div class="note-content">@((MarkupString)HtmlSanitizing.Notes(notes))</div>
        }
        else
        {
            <p class="mb-0" style="white-space:pre-wrap">@notes</p>
        }
    };

    private void SetMessage(string msg, bool error = false)
    {
        _message = msg;
        _isError = error;
    }

    public void Dispose() => _dotNetRef?.Dispose();
}
