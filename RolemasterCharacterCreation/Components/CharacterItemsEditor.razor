@* Equipment list editor, shared by the GM edit page and the player's own character page.
   Items are the one part of a character a player may change freely after creation: loot,
   supplies bought in town, things handed to another character. An item may also carry
   combat bonuses — the sheet reads those to work out OB and DB. Rows are mutated in
   place; the host page owns the Save button. *@
@using RolemasterCharacterCreation.Data
@using RolemasterCharacterCreation.Rules
@inject AppDbContext Db

<datalist id="@($"dl-items-{_uid}")">
    @foreach (var it in EquipmentRules.General) { <option value="@it.Name" /> }
    @foreach (var it in EquipmentRules.Weapons) { <option value="@it.Name" /> }
</datalist>

@if (Character.EquipmentItems.Any())
{
    <table class="table table-sm table-bordered mb-3" style="max-width:940px">
        <thead>
            <tr>
                <th>Item</th>
                <th style="width:70px">Qty</th>
                <th style="width:90px" title="Pounds, each. Blank uses the equipment tables; set it for anything they do not list, or encumbrance will not count it">Wt (lb)</th>
                <th style="width:80px" title="Worn or wielded — only equipped gear counts">Equipped</th>
                <th style="width:70px" title="Offensive bonus">OB</th>
                <th style="width:170px" title="Which weapon the OB applies to">OB applies to</th>
                <th style="width:70px" title="Defensive bonus — applies whenever equipped">DB</th>
                <th style="width:46px"></th>
            </tr>
        </thead>
        <tbody>
            @* Ordered by Id, not name, so a row doesn't jump while its name is being typed. *@
            @foreach (var ei in Character.EquipmentItems.OrderBy(e => e.Id == 0 ? int.MaxValue : e.Id).ToList())
            {
                <tr class="@(ei.IsEquipped ? "" : "text-muted")">
                    <td>
                        <input class="form-control form-control-sm" list="@($"dl-items-{_uid}")"
                               value="@ei.Name" @onchange="e => Rename(ei, e)" />
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm" min="1"
                               value="@ei.Qty" @onchange="e => SetQty(ei, e)" />
                    </td>
                    <td>
                        @* Blank means "use the tables"; the placeholder shows what they say,
                           so an item they do not list reads 0 and asks to be filled in. *@
                        <input type="number" step="0.1" min="0" class="form-control form-control-sm"
                               placeholder="@CatalogueWeight(ei.Name).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                               value="@(ei.WeightLbs?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                               @onchange="e => SetWeight(ei, e)" />
                    </td>
                    <td class="text-center align-middle">
                        <input type="checkbox" class="form-check-input"
                               checked="@ei.IsEquipped" @onchange="e => SetEquipped(ei, e)" />
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm"
                               value="@ei.ObBonus" @onchange="e => SetOb(ei, e)" />
                    </td>
                    <td>
                        <select class="form-select form-select-sm"
                                value="@(ei.AppliesTo ?? "")"
                                @onchange="e => SetAppliesTo(ei, e)">
                            @* Spelled out, because "all weapons" quietly includes unarmed. *@
                            <option value="">All weapons (incl. unarmed)</option>
                            @foreach (var w in WeaponSpecs)
                            {
                                <option value="@w">@w</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm"
                               value="@ei.DbBonus" @onchange="e => SetDb(ei, e)" />
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1"
                                title="Remove this item" @onclick="() => Remove(ei)">×</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted small">
        <strong>Wt</strong> is pounds each; leave it blank to use the equipment tables, and fill it
        in for anything they do not list — encumbrance counts what a character carries as well as
        what they wear, and an unweighed item counts as nothing.
        Leave OB and DB at 0 for ordinary gear. An <strong>OB</strong> applies only to the weapon
        you pick (a +10 broadsword does nothing for your bow); a <strong>DB</strong> applies
        whenever the item is equipped. Unequipped items are carried but change no numbers.
    </p>
}
else
{
    <p class="text-muted small mb-3">No items yet.</p>
}

<div class="row g-2 align-items-end mb-2" style="max-width:520px">
    <div class="col">
        <label class="form-label small mb-1">Item</label>
        <input class="form-control form-control-sm" list="@($"dl-items-{_uid}")"
               placeholder="Pick one, or type anything" @bind="_addName"
               @onkeydown="OnAddKeyDown" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-1">Qty</label>
        <input type="number" class="form-control form-control-sm" style="width:80px"
               min="1" @bind="_addQty" />
    </div>
    <div class="col-auto">
        <button type="button" class="btn btn-sm btn-outline-success" @onclick="Add">+ Add</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_note))
{
    <div class="text-muted small mb-2">@_note</div>
}

@code {
    // The character being edited. EquipmentItems is mutated in place; the host page saves
    // through the same scoped DbContext.
    [Parameter, EditorRequired] public Character Character { get; set; } = default!;

    private readonly string _uid = Guid.NewGuid().ToString("N")[..6];

    private string _addName = "";
    private int    _addQty  = 1;
    private string? _note;

    // Weapons this character actually has, so an OB can only be pointed at a real one.
    private IEnumerable<string> WeaponSpecs => Character.Skills
        .Where(s => s.Specialization is not null && WeaponRules.BySkill.ContainsKey(s.SkillName))
        .Select(s => s.Specialization!)
        .Distinct()
        .OrderBy(s => s);

    /// <summary>
    /// The weapon an item names, if it names one. "War Hammer +10" is a war hammer's bonus,
    /// not a blanket one that also sharpens your fists — but left on "all weapons" that is
    /// exactly what it became, quietly adding itself to Unarmed Striking as well.
    /// The longest match wins, so a "War Hammer" is not taken for a "Hammer".
    /// </summary>
    private string? WeaponNamedIn(string itemName) => WeaponSpecs
        .Where(w => itemName.Contains(w, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(w => w.Length)
        .FirstOrDefault();

    private void Add()
    {
        _note = null;
        var name = _addName.Trim();
        if (name.Length == 0) { _note = "Type or pick an item name first."; return; }

        int qty = Math.Max(1, _addQty);

        // Adding something already carried tops up the stack rather than dead-ending on
        // a duplicate-name error.
        var existing = Character.EquipmentItems
            .FirstOrDefault(e => string.Equals(e.Name, name, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            existing.Qty += qty;
            _note = $"{existing.Name} is already carried — quantity is now {existing.Qty}.";
        }
        else
        {
            var item = new CharacterEquipmentItem
            {
                CharacterId = Character.Id,
                Name        = name,
                Qty         = qty,
                AppliesTo   = WeaponNamedIn(name),
            };
            Character.EquipmentItems.Add(item);
            Db.CharacterEquipmentItems.Add(item);
        }

        _addName = "";
        _addQty  = 1;
    }

    private void OnAddKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Add();
    }

    private void Rename(CharacterEquipmentItem ei, ChangeEventArgs e)
    {
        var name = e.Value?.ToString()?.Trim() ?? "";
        if (name.Length == 0) { _note = "An item needs a name."; return; }
        _note = null;

        // Re-point the OB only while it is still whatever the old name implied. Anyone who has
        // chosen for themselves keeps that choice through a rename — a blanket bonus left on a
        // weapon-named item, or one weapon's bonus on an item named after another. Comparing
        // against the old name is what tells the two apart, since "all weapons" is stored as
        // null and is otherwise indistinguishable from never having chosen.
        bool wasAuto = ei.AppliesTo == WeaponNamedIn(ei.Name);
        ei.Name = name;
        if (wasAuto) ei.AppliesTo = WeaponNamedIn(name);
    }

    private void SetQty(CharacterEquipmentItem ei, ChangeEventArgs e) =>
        ei.Qty = int.TryParse(e.Value?.ToString(), out var q) ? Math.Max(1, q) : 1;

    // Pounds each. Blank clears it, so the item falls back to the tables.
    private void SetWeight(CharacterEquipmentItem ei, ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        ei.WeightLbs = double.TryParse(v, System.Globalization.NumberStyles.Float,
                                       System.Globalization.CultureInfo.InvariantCulture, out var w)
                       && w >= 0 ? w : null;
    }

    private static double CatalogueWeight(string name) =>
        EquipmentRules.General.FirstOrDefault(i => i.Name == name)?.WeightLbs
        ?? EquipmentRules.Weapons.FirstOrDefault(i => i.Name == name)?.WeightLbs
        ?? 0;

    private void SetOb(CharacterEquipmentItem ei, ChangeEventArgs e) =>
        ei.ObBonus = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;

    private void SetDb(CharacterEquipmentItem ei, ChangeEventArgs e) =>
        ei.DbBonus = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;

    private void SetEquipped(CharacterEquipmentItem ei, ChangeEventArgs e) =>
        ei.IsEquipped = (bool)(e.Value ?? false);

    private void SetAppliesTo(CharacterEquipmentItem ei, ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        ei.AppliesTo = string.IsNullOrEmpty(v) ? null : v;
    }

    private void Remove(CharacterEquipmentItem ei)
    {
        _note = null;
        Character.EquipmentItems.Remove(ei);
        Db.CharacterEquipmentItems.Remove(ei);
    }
}
